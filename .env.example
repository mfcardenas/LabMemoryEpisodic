# Todas las rutas relativas se resuelven contra la raíz de LabMemoryEpisodic.
EPIGRAPH_DATA_DIR=episodic-data
EPIGRAPH_VECTOR_BACKEND=edge
EPIGRAPH_QDRANT_HOST=127.0.0.1
EPIGRAPH_QDRANT_PORT=6333
EPIGRAPH_QDRANT_COLLECTION=episodic_memory
EPIGRAPH_HOST=127.0.0.1
EPIGRAPH_PORT=8100
EPIGRAPH_LOG_LEVEL=INFO
# Opcional: activa persistencia de logs.
# EPIGRAPH_LOG_FILE=episodic-data/logs/epigraph.log

# Percepción de vídeo (requiere `pip install -e ".[video]"` y Ollama en marcha).
# EPIGRAPH_VISION_BACKEND=ollama        # ollama | fake | none
# EPIGRAPH_VISION_MODEL=qwen3.5:4b
# EPIGRAPH_OLLAMA_URL=http://127.0.0.1:11434
# EPIGRAPH_VIDEO_SAMPLE_FPS=1.0
# EPIGRAPH_VIDEO_MIN_SEGMENT_SECONDS=2
# EPIGRAPH_VIDEO_MAX_SEGMENT_SECONDS=15
# EPIGRAPH_VIDEO_SCENE_THRESHOLD=0.12
# EPIGRAPH_DESCRIPTION_LANGUAGE=es
