# Todas las rutas relativas se resuelven contra la raíz de LabMemoryEpisodic.
EPIGRAPH_DATA_DIR=episodic-data
# http: servidor/contenedor Qdrant (recomendado). edge: ficheros locales en
# <data>/index/qdrant-edge, solo para demos y pruebas sin servidor.
EPIGRAPH_VECTOR_BACKEND=http
EPIGRAPH_QDRANT_HOST=127.0.0.1
EPIGRAPH_QDRANT_PORT=6333
EPIGRAPH_QDRANT_COLLECTION=episodic_memory
EPIGRAPH_HOST=127.0.0.1
EPIGRAPH_PORT=8100
EPIGRAPH_LOG_LEVEL=INFO

# Búsqueda por pasajes (Consultas). Tras cambiar el modelo o los prefijos,
# vuelva a indexar (reset-data y recarga, o rebuild-index).
# EPIGRAPH_NOMIC_DOCUMENT_PREFIX="search_document: "
# EPIGRAPH_NOMIC_QUERY_PREFIX="search_query: "
# EPIGRAPH_ENCODER_THREADS=2            # hilos de CPU de los encoders; subirlo acelera la indexación
# EPIGRAPH_ENCODER_BATCH_SIZE=1         # textos por lote; 1 evita rellenar hasta el más largo (en GPU: 16)
# EPIGRAPH_ENCODER_DEVICE=cpu           # cpu | cuda | auto; la GPU solo con el extra [gpu] y a petición (ver README)
# EPIGRAPH_PASSAGE_CANDIDATES=60        # por cada vía: significado y texto completo
# EPIGRAPH_PASSAGE_MAX_EPISODES=10
# EPIGRAPH_PASSAGE_PER_EPISODE=5
# EPIGRAPH_RERANK_MODEL=jinaai/jina-reranker-v2-base-multilingual   # vacío: sin reordenar
# EPIGRAPH_RERANK_CANDIDATES=20
# EPIGRAPH_RERANK_THREADS=0             # 0: todos los núcleos
# EPIGRAPH_RERANK_MAX_CHARS=800         # texto de cada pasaje que ve el reordenador
# EPIGRAPH_RERANK_MIN_SCORE=-1.5        # por debajo se descarta; vacío: sin umbral
# EPIGRAPH_PASSAGE_AGREEMENT_RANK=3     # …salvo si significado y palabras lo ponen ambos en su top N; 0: nunca
# EPIGRAPH_QUERY_TIMEZONE=Europe/Madrid # zona horaria de «ayer», «el lunes por la tarde», «después de las 16:30»; vacío: la del sistema
# Resúmenes jerárquicos (episodio, día, entorno) con el modelo de texto de Ollama.
# EPIGRAPH_TEXT_BACKEND=ollama          # ollama | fake | none (none: sin resúmenes)
# EPIGRAPH_TEXT_MODEL=gpt-oss:latest    # la etiqueta gpt-oss:20b antigua falla en Ollama ≥ 0.35; vuelva a descargarla o use :latest
# EPIGRAPH_TEXT_REASONING=low           # esfuerzo de gpt-oss: low | medium | high
# EPIGRAPH_TEXT_NUM_CTX=16384           # ventana de contexto; un episodio largo necesita más
# EPIGRAPH_TEXT_TEMPERATURE=0.2
# EPIGRAPH_TEXT_TIMEOUT_SECONDS=600
# EPIGRAPH_TEXT_MAX_INPUT_CHARS=16000   # eventos + habla + documentos que ve el modelo por resumen
# EPIGRAPH_DIGEST_ENVIRONMENT_DAYS=30   # días que entran en el resumen de un entorno
# Agente de respuestas (Preguntar): gpt-oss con las herramientas de memoria.
# EPIGRAPH_AGENT_BACKEND=ollama         # ollama | fake | none
# EPIGRAPH_AGENT_MODEL=                 # vacío: el de EPIGRAPH_TEXT_MODEL
# EPIGRAPH_AGENT_REASONING=low          # low | medium | high
# EPIGRAPH_AGENT_MAX_STEPS=8            # vueltas del modelo por pregunta
# EPIGRAPH_AGENT_MAX_TOOL_CALLS=12
# EPIGRAPH_AGENT_MAX_SECONDS=120
# EPIGRAPH_AGENT_NUM_CTX=32768          # ventana de contexto; varios resultados de herramienta por pregunta
# EPIGRAPH_AGENT_TOOL_RESULT_CHARS=12000 # caracteres de cada resultado de herramienta que ve el modelo
# Opcional: activa persistencia de logs.
# EPIGRAPH_LOG_FILE=episodic-data/logs/epigraph.log

# Entrada automática: carpetas vigiladas (ver watch.example.toml). Vacío: sin
# vigilancia. `epigraph serve` vigila si está definido; `epigraph watch` sin web.
# EPIGRAPH_WATCH_CONFIG=watch.toml
# EPIGRAPH_ACTIVITY_LOG_MAX_ROWS=5000    # líneas del registro de ejecución (0: todas)
# EPIGRAPH_ACTIVITY_LOG_MAX_PASSES=1000  # pases del vigilante que se conservan aparte (0: todos)

# Percepción de vídeo (requiere `pip install -e ".[video]"` y Ollama en marcha).
# EPIGRAPH_VISION_BACKEND=ollama        # ollama | fake | none
# EPIGRAPH_VISION_MODEL=qwen3.5:4b
# EPIGRAPH_OLLAMA_URL=http://127.0.0.1:11434
# EPIGRAPH_VIDEO_SAMPLE_FPS=1.0
# EPIGRAPH_VIDEO_MIN_SEGMENT_SECONDS=2
# EPIGRAPH_VIDEO_MAX_SEGMENT_SECONDS=15
# EPIGRAPH_VIDEO_SCENE_THRESHOLD=0.12
# EPIGRAPH_DESCRIPTION_LANGUAGE=es
# EPIGRAPH_VISION_TIMEOUT_SECONDS=300
# EPIGRAPH_VISION_TEMPERATURE=0.2
# EPIGRAPH_VISION_THINK=false           # razonamiento previo de Ollama
# EPIGRAPH_VIDEO_MAX_KEYFRAMES=3         # fotogramas clave por tramo
# EPIGRAPH_VIDEO_FRAME_MAX_SIDE=768      # px del lado mayor enviado al modelo
# EPIGRAPH_VIDEO_JPEG_QUALITY=85

# Transcripción del habla (Fase D). Servicio HTTP compatible con la API de
# OpenAI (/v1/audio/transcriptions); por defecto Speaches en Docker:
#   docker compose up -d speech
#   epigraph speech-check --download --file <audio_o_video>
# EPIGRAPH_SPEECH_BACKEND=http          # http | fake | none
# EPIGRAPH_SPEECH_URL=http://127.0.0.1:8010
# EPIGRAPH_SPEECH_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
# EPIGRAPH_SPEECH_LANGUAGE=es           # vacío = autodetección
# EPIGRAPH_SPEECH_TIMEOUT_SECONDS=600
# EPIGRAPH_SPEECH_API_KEY=              # si el servicio exige clave
# EPIGRAPH_SPEECH_PROMPT=               # vocabulario: "latiguillo, radial, rótula…"
# EPIGRAPH_SPEECH_TEMPERATURE=0
# EPIGRAPH_SPEECH_SAMPLE_RATE_HZ=16000

# Lanzadores start.bat / start.sh.
# EPIGRAPH_PYTHON=                       # intérprete; por defecto, el del entorno Conda
# EPIGRAPH_CONDA_ENV=LabMemoryEpic01
# EPIGRAPH_COMPOSE_SERVICES=qdrant speech   # "none": no levantar nada con docker

# Contenedor de Qdrant (docker compose up -d qdrant). EPIGRAPH_QDRANT_PORT
# debe coincidir con QDRANT_HOST_PORT.
# QDRANT_IMAGE=qdrant/qdrant:v1.16.2
# QDRANT_CONTAINER_NAME=epigraph-qdrant
# QDRANT_HOST_PORT=6333
# QDRANT_GRPC_HOST_PORT=6334
# QDRANT_LOG_LEVEL=INFO

# Contenedor de transcripción (docker-compose.yml lee estas mismas variables).
# SPEECH_IMAGE=ghcr.io/speaches-ai/speaches:latest-cuda   # o :latest-cpu
# SPEECH_HOST_PORT=8010
# SPEECH_DEVICE=cuda                    # cuda | cpu | auto
# SPEECH_COMPUTE_TYPE=float16           # int8 ahorra memoria
# SPEECH_MODEL_TTL=300                  # s que el modelo sigue cargado sin uso (-1: siempre)
